      "name": "1. Autenticação",
      "item": [
        {
          "name": "Registrar responsável",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registrar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registrar"
              ]
            },
            "description": "RF01 — cria responsável e devolve token JWT. CPF/e-mail gerados automaticamente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Responsável Teste\",\n  \"cpf\": \"{{cpfNovo}}\",\n  \"email\": \"{{emailNovo}}\",\n  \"senha\": \"segredo1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gera um CPF válido e um e-mail únicos para cada execução",
                  "const n = Array.from({length: 9}, () => Math.floor(Math.random() * 10));",
                  "const dv = (b) => { const s = b.reduce((a, d, i) => a + d * (b.length + 1 - i), 0); const r = (s * 10) % 11; return r === 10 ? 0 : r; };",
                  "n.push(dv(n)); n.push(dv(n));",
                  "pm.collectionVariables.set('cpfNovo', n.join(''));",
                  "pm.collectionVariables.set('emailNovo', 'teste' + Date.now() + '@poupakids.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.expect(pm.response.code).to.be.oneOf([201]));"
                ]
              }
            }
          ]
        },

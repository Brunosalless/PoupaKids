# Porta da API
PORT=3333

# Banco de dados: mysql (oficial) ou sqlite (demonstração sem instalar MySQL)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=BancoKids
DB_USER=root
DB_PASS=
# Usado apenas quando DB_DIALECT=sqlite
DB_STORAGE=./bancokids.sqlite
# "alter" ajusta tabelas existentes (ex.: banco criado na Fase 0) às colunas novas
DB_SYNC=

# Autenticação
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h

# Origem do frontend em desenvolvimento (Vite)
CORS_ORIGIN=http://localhost:5173

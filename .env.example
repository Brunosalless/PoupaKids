# ============================================
# POUPAKIDS - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ============================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit de arquivos .env com dados reais.

# --------------------------------------------
# BACKEND
# --------------------------------------------

# Ambiente: development | production | test
NODE_ENV=development

# Porta do servidor Express
PORT=3000

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=PoupaKids
DB_NAME=BancoKids

# JWT
JWT_SECRET=PoupaKidsFaculdadeUniQuintoSemeste
JWT_EXPIRES_IN=7d

# CORS (lista separada por vírgula)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Rate Limiting (rotas de auth)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# --------------------------------------------
# FRONTEND (React Native / Expo)
# --------------------------------------------

# URL base da API (desenvolvimento local)
# Android emulator: use http://10.0.2.2:3000/api
# iOS simulator:   use http://localhost:3000/api
# Dispositivo físico: use o IP da máquina (ex.: http://192.168.0.10:3000/api)
API_BASE_URL=http://localhost:3000/api

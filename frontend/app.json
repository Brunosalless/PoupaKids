{
  "expo": {
    "name": "PoupaKids",
    "slug": "poupakids",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "poupakids",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FAF5FF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.poupakids.app"
    },
    "android": {
      "package": "com.poupakids.app",
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": []
  }
}
